{
  "name": "lania-cli-v2-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@clack/prompts": "^1.7.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "danger": "^13.0.7",
    "depcheck": "^1.4.7",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "knip": "^5.62.0",
    "lint-staged": "^15.2.10",
    "npm-check-updates": "^17.1.15",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.0.0"
  },
  "scripts": {
    "changeset:add": "changeset",
    "changeset:version": "changeset version && node ./scripts/sync-rust-version.mjs",
    "prepare": "husky",
    "commit": "cz",
    "bootstrap": "pnpm install --no-frozen-lockfile && cargo fetch --manifest-path Cargo.toml",
    "bootstrap:ci": "pnpm install --frozen-lockfile && cargo fetch --manifest-path Cargo.toml",
    "check": "pnpm bridge:check && pnpm packages:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm pack",
    "packages:check": "node ./scripts/check-package-manifests.mjs && pnpm known:check",
    "bridge:gen": "node ./packages/products/bridge-hub/protocol/gen.mjs",
    "bridge:check": "node ./scripts/check-bridge-protocol.mjs",
    "bridge:selftest": "node ./scripts/check-bridge-protocol.mjs --self-test",
    "test": "pnpm -r test && cargo test --manifest-path Cargo.toml --workspace",
    "smoke:pi": "node ./scripts/smoke-pi.mjs",
    "test:rust": "cargo nextest run --manifest-path Cargo.toml --workspace",
    "test:rust:std": "cargo test --manifest-path Cargo.toml --workspace",
    "clean": "node ./scripts/clean.mjs",
    "lint:staged": "pnpm exec lint-staged",
    "audit:js": "pnpm audit",
    "audit:rust": "cargo audit",
    "audit:all": "pnpm audit:js && pnpm audit:rust",
    "deps:audit": "cargo deny check",
    "deps:unused": "pnpm exec knip",
    "deps:depcheck": "pnpm --filter @lania-cli-v2/bridge-runtime exec depcheck . && pnpm --filter @lania-cli-v2/templates exec depcheck . && pnpm --filter @lania-cli-v2/cli exec depcheck . && pnpm --filter @lania-cli-v2/cli-darwin-arm64 exec depcheck .",
    "deps:update:check": "pnpm exec ncu -r",
    "deps:update": "pnpm exec ncu -r -u",
    "deps:outdated": "pnpm outdated -r",
    "format": "prettier -w package.json pnpm-workspace.yaml .changeset .github scripts eslint.config.js prettier.config.cjs commitlint.config.cjs renovate.json knip.json dangerfile.mjs",
    "format:check": "prettier -c package.json pnpm-workspace.yaml .changeset .github scripts eslint.config.js prettier.config.cjs commitlint.config.cjs renovate.json knip.json dangerfile.mjs",
    "lint": "pnpm lint:ts && pnpm lint:rust",
    "lint:ts": "eslint \"packages/**/*.{ts,tsx,js,mjs,cjs}\"",
    "lint:ts:fix": "eslint \"packages/**/*.{ts,tsx,js,mjs,cjs}\" --fix",
    "lint:rust": "cargo clippy --manifest-path Cargo.toml --workspace --all-targets -- -D warnings",
    "typecheck": "pnpm typecheck:ts",
    "typecheck:ts": "pnpm -r typecheck",
    "format:rust": "cargo fmt --manifest-path Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path Cargo.toml --all -- --check",
    "coverage:rust": "cargo llvm-cov --manifest-path Cargo.toml --workspace --lcov --output-path coverage/rust/lcov.info",
    "deps:rust:unused": "cargo machete --with-metadata --manifest-path Cargo.toml",
    "tools:install:rust": "cargo install --locked cargo-deny cargo-nextest cargo-audit cargo-machete cargo-llvm-cov",
    "danger:ci": "danger ci",
    "docs:install": "npm install --prefix docs-site",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "docs:preview": "npm --prefix docs-site run preview",
    "docs:md:move": "node ./scripts/move-markdown-to-docs.mjs",
    "pack": "node ./scripts/pack.mjs",
    "release": "node ./scripts/release.mjs",
    "publish": "node ./scripts/publish.mjs",
    "publish:all": "node ./scripts/publish-all.mjs",
    "publish:npm": "node ./packages/distribution/cli/npm/cli/bin/lan.mjs product publish --execute --yes",
    "publish:auth": "node ./scripts/configure-npm-auth.mjs",
    "publish:verdaccio": "node ./scripts/verdaccio-smoke.mjs",
    "alias": "alias lan='cargo run --manifest-path /Users/bytedance/Desktop/files/self/lania-zip/lania-cli-v2/Cargo.toml -p lania-cli --'",
    "known:commands": "node ./scripts/gen-known-commands.mjs",
    "known:compat": "node ./scripts/gen-compat.mjs",
    "known:matrix": "node ./scripts/gen-artifact-matrix.mjs",
    "known:check": "node ./scripts/gen-known-commands.mjs --check && node ./scripts/gen-compat.mjs --check && node ./scripts/gen-artifact-matrix.mjs --check"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier -w"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier -w"
    ]
  }
}
