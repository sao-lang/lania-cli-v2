{
  "name": "@lania-cli-v2/bridge-protocol",
  "version": "0.0.3",
  "private": false,
  "description": "Bridge Hub 语言中立帧协议（由 protocol/schema.json 生成，跨语言共用）",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "node ./scripts/copy-gen.mjs",
    "build": "node ./scripts/copy-gen.mjs && node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "node ./scripts/copy-gen.mjs && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
