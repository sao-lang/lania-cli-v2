    {
      "command": "workspace",
      "package": "@lania-cli-v2/cmd-workspace",
      "bin": "lan-workspace",
      "npmBin": "lan-workspace.mjs",
      "order": 1,
      "describe": "describes/workspace.json",
      "about": "Workspace development workflows (dev/build/lint/create/add)",
      "aboutZh": "Workspace 开发工作流（dev/build/lint/create/add）",
      "needsNodeBridge": true,
      "slices": [
        "compiler",
        "config",
        "lifecycle",
        "lint",
        "toolchain",
        "template",
        "dynamic-commands"
      ],
      "platformPackages": [
        "@lania-cli-v2/cmd-workspace-darwin-arm64",
        "@lania-cli-v2/cmd-workspace-linux-x64",
        "@lania-cli-v2/cmd-workspace-win32-x64"
      ],
      "protocol": 1,
      "configSchema": {
        "scope": "package",
        "path": "~/.lania/config/workspace.json",
        "keys": [
          {
            "key": "locale",
            "kind": "enum",
            "choices": ["zh", "en"],
            "default": "en",
            "description": "包级偏好：界面语言（zh | en，默认 en）；与全局 lan config 的 locale 同名；主包 preferences 的 packages.workspace 段可覆盖本文件键值"
          },
          {
            "key": "output.mode",
            "kind": "enum",
            "choices": ["json", "human"],
            "default": "json",
            "description": "包级偏好：输出模式（json | human，默认 json）；与全局 lan config 的 output.mode 同名；主包 preferences 的 packages.workspace 段可覆盖本文件键值"
          },
          {
            "key": "log.timestamps",
            "kind": "bool",
            "default": false,
            "description": "包级偏好：人类可读日志是否显示时间戳（默认 false）；与全局 lan config 的 log.timestamps 同名；主包 preferences 的 packages.workspace 段可覆盖本文件键值"
          }
        ]
      }
    },
