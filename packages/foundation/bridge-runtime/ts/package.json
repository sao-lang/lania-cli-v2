{
  "name": "@lania-cli-v2/bridge-runtime",
  "version": "0.0.3",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "bridge": "tsx src/stdio.ts",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test ./src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "@lania-cli-v2/bridge-slice-config": "workspace:*",
    "@lania-cli-v2/bridge-slice-dynamic-commands": "workspace:*",
    "@lania-cli-v2/bridge-slice-lifecycle": "workspace:*",
    "@lania-cli-v2/bridge-slice-compiler": "workspace:*",
    "@lania-cli-v2/bridge-slice-product": "workspace:*",
    "@lania-cli-v2/bridge-slice-lint": "workspace:*",
    "@lania-cli-v2/bridge-slice-system": "workspace:*",
    "@lania-cli-v2/bridge-slice-template": "workspace:*",
    "@lania-cli-v2/bridge-slice-toolchain": "workspace:*",
    "@lania-cli-v2/bridge-slice-commitizen": "workspace:*",
    "@lania-cli-v2/bridge-slice-commitlint": "workspace:*",
    "@lania-cli-v2/bridge-slice-agent": "workspace:*"
  },
  "dependencies": {
    "tsx": "^4.19.0",
    "yaml": "^2.8.1",
    "@lania-cli-v2/bridge-protocol": "workspace:*"
  }
}
