{
  "name": "pi",
  "kind": "command",
  "command": "pi",
  "versionFamily": "lan",
  "version": "0.0.3",
  "order": 12,
  "describe": "describes/pi.json",
  "api": {
    "protocol": 1,
    "rust": {
      "cratePath": "rust",
      "lib": "lania-plugins-command-pi",
      "bin": "lan-pi",
      "features": [],
      "dependencies": ["lania-cli-kit", "lania-bridge-host", "runex-home"],
      "api": {
        "factory": "lania-plugins-command-pi::factory",
        "spec": "lania-plugins-command-pi::spec",
        "surface": [
          "COMMAND_NAME",
          "HANDLER_ID",
          "PiCommandPlugin",
          "PiCommandPlugin::spec",
          "spec",
          "factory"
        ]
      }
    }
  },
  "rust": {
    "crates": ["rust"]
  },
  "npm": {
    "name": "@lania-cli-v2/cmd-pi",
    "bin": {
      "lan-pi": "npm/cmd-pi/bin/lan-pi.mjs"
    },
    "platformPackages": [
      "@lania-cli-v2/cmd-pi-darwin-arm64",
      "@lania-cli-v2/cmd-pi-linux-x64",
      "@lania-cli-v2/cmd-pi-win32-x64"
    ]
  },
  "payload": {
    "slices": ["agent", "toolchain"],
    "nodeBridge": true
  },
  "configSchema": {
    "scope": "package",
    "path": "~/.lania/config/pi.json",
    "keys": [
      {
        "key": "locale",
        "kind": "enum",
        "choices": ["zh", "en"],
        "default": "en",
        "description": "包级偏好：界面语言（zh | en，默认 en）；与全局 lan config 的 locale 同名"
      },
      {
        "key": "output.mode",
        "kind": "enum",
        "choices": ["json", "human"],
        "default": "json",
        "description": "包级偏好：输出模式（json | human，默认 json）；与全局 lan config 的 output.mode 同名"
      },
      {
        "key": "log.timestamps",
        "kind": "bool",
        "default": false,
        "description": "包级偏好：人类可读日志是否显示时间戳（默认 false）；与全局 lan config 的 log.timestamps 同名"
      }
    ]
  },
  "description": "pi 命令子包：编码 agent（pi 引擎，交互 REPL / 一次性执行）"
}
