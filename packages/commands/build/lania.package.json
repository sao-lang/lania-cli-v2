{
  "name": "build",
  "kind": "command",
  "command": "build",
  "versionFamily": "lan",
  "version": "0.0.3",
  "order": 2,
  "describe": "describes/build.json",
  "api": {
    "protocol": 1,
    "rust": {
      "cratePath": "rust",
      "lib": "lania-plugins-command-build",
      "bin": "lan-build",
      "features": [],
      "dependencies": ["lania-cli-kit", "lania-bridge-host", "runex-home"],
      "api": {
        "factory": "lania-plugins-command-build::factory",
        "spec": "lania-plugins-command-build::spec",
        "surface": [
          "COMMAND_NAME",
          "HANDLER_ID",
          "BuildCommandPlugin",
          "BuildCommandPlugin::spec",
          "spec",
          "factory"
        ]
      }
    }
  },
  "rust": {
    "crates": ["rust"]
  },
  "npm": {
    "name": "@lania-cli-v2/cmd-build",
    "bin": {
      "lan-build": "npm/cmd-build/bin/lan-build.mjs"
    },
    "platformPackages": [
      "@lania-cli-v2/cmd-build-darwin-arm64",
      "@lania-cli-v2/cmd-build-linux-x64",
      "@lania-cli-v2/cmd-build-win32-x64"
    ]
  },
  "payload": {
    "slices": ["compiler", "product", "config", "lifecycle", "lint", "toolchain"],
    "nodeBridge": true
  },
  "configSchema": {
    "scope": "package",
    "path": "~/.lania/config/build.json",
    "keys": [
      {
        "key": "locale",
        "kind": "enum",
        "choices": ["zh", "en"],
        "default": "en",
        "description": "包级偏好：界面语言（zh | en，默认 en）；与全局 lan config 的 locale 同名"
      },
      {
        "key": "output.mode",
        "kind": "enum",
        "choices": ["json", "human"],
        "default": "json",
        "description": "包级偏好：输出模式（json | human，默认 json）；与全局 lan config 的 output.mode 同名"
      },
      {
        "key": "log.timestamps",
        "kind": "bool",
        "default": false,
        "description": "包级偏好：人类可读日志是否显示时间戳（默认 false）；与全局 lan config 的 log.timestamps 同名"
      }
    ]
  }
}
