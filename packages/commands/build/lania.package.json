{
  "name": "build",
  "kind": "command",
  "command": "build",
  "versionFamily": "lan",
  "version": "0.0.3",
  "order": 2,
  "describe": "describes/build.json",
  "api": {
    "protocol": 1,
    "rust": {
      "cratePath": "rust",
      "lib": "lania_plugins_command_build",
      "bin": "lan-build",
      "features": [],
      "dependencies": ["lania-cli-kit", "lania-bridge-host", "runex-home"],
      "api": {
        "factory": "lania_plugins_command_build::factory",
        "spec": "lania_plugins_command_build::spec",
        "surface": [
          "COMMAND_NAME",
          "HANDLER_ID",
          "BuildCommandPlugin",
          "BuildCommandPlugin::spec",
          "spec",
          "factory"
        ]
      }
    }
  },
  "rust": {
    "crates": ["rust"]
  },
  "npm": {
    "name": "@lania-cli-v2/cmd-build",
    "bin": {
      "lan-build": "npm/cmd-build/bin/lan-build.mjs"
    },
    "platformPackages": [
      "@lania-cli-v2/cmd-build-darwin-arm64",
      "@lania-cli-v2/cmd-build-linux-x64",
      "@lania-cli-v2/cmd-build-win32-x64"
    ]
  },
  "payload": {
    "slices": ["compiler", "product", "config", "lifecycle"],
    "nodeBridge": true
  }
}
