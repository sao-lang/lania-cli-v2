{
  "name": "lint",
  "kind": "command",
  "command": "lint",
  "versionFamily": "lan",
  "version": "0.0.3",
  "order": 3,
  "describe": "describes/lint.json",
  "api": {
    "protocol": 1,
    "rust": {
      "cratePath": "rust",
      "lib": "lania-plugins-command-lint",
      "bin": "lan-lint",
      "features": [],
      "dependencies": ["lania-cli-kit", "lania-bridge-host", "runex-home"],
      "api": {
        "factory": "lania-plugins-command-lint::factory",
        "spec": "lania-plugins-command-lint::spec",
        "surface": [
          "COMMAND_NAME",
          "HANDLER_ID",
          "LintCommandPlugin",
          "LintCommandPlugin::spec",
          "spec",
          "factory"
        ]
      }
    }
  },
  "rust": {
    "crates": ["rust"]
  },
  "npm": {
    "name": "@lania-cli-v2/cmd-lint",
    "bin": {
      "lan-lint": "npm/cmd-lint/bin/lan-lint.mjs"
    },
    "platformPackages": [
      "@lania-cli-v2/cmd-lint-darwin-arm64",
      "@lania-cli-v2/cmd-lint-linux-x64",
      "@lania-cli-v2/cmd-lint-win32-x64"
    ]
  },
  "payload": {
    "slices": ["lint", "toolchain", "config"],
    "nodeBridge": true
  },
  "configSchema": {
    "scope": "package",
    "path": "~/.lania/config/lint.json",
    "keys": [
      {
        "key": "locale",
        "kind": "enum",
        "choices": ["zh", "en"],
        "default": "en",
        "description": "包级偏好：界面语言（zh | en，默认 en）；与全局 lan config 的 locale 同名"
      },
      {
        "key": "output.mode",
        "kind": "enum",
        "choices": ["json", "human"],
        "default": "json",
        "description": "包级偏好：输出模式（json | human，默认 json）；与全局 lan config 的 output.mode 同名"
      },
      {
        "key": "log.timestamps",
        "kind": "bool",
        "default": false,
        "description": "包级偏好：人类可读日志是否显示时间戳（默认 false）；与全局 lan config 的 log.timestamps 同名"
      }
    ]
  },
  "description": "lint 命令子包：多 linter 代码检查与修复（TS payload 经 lib/bridge 提供）"
}
