{
  "name": "env",
  "about": "Install and switch language runtimes managed by lania itself (node/python/go/rust/deno/bun/zig/java/dart/kotlin/scala/julia/d/v/crystal/gleam/haxe/elixir)",
  "alias": null,
  "aliases": [],
  "args": [],
  "options": [],
  "examples": [
    {
      "command": "lan env init",
      "description": "Print the snippet that puts ~/.runex/shims on PATH"
    },
    {
      "command": "lan env install node 20 --yes",
      "description": "Download node 20.x from nodejs.org and register it"
    },
    {
      "command": "lan env use node 20",
      "description": "Point the node current pointer at 20.x and regenerate shims"
    },
    {
      "command": "lan env list --installed",
      "description": "List only the versions lania itself installed"
    },
    {
      "command": "lan env info node",
      "description": "Inspect node: binary path, source, upstream, project pin"
    },
    {
      "command": "lan env which node",
      "description": "Print the binary the node shim currently resolves to"
    },
    {
      "command": "lan env use python 3.12 --project",
      "description": "Pin python 3.12 into .python-version for this project"
    },
    {
      "command": "lan env remove node 18 --yes",
      "description": "Delete the lania-managed node 18 directory"
    },
    {
      "command": "lan env doctor",
      "description": "Report missing runtimes, shim gaps and PATH problems"
    },
    {
      "command": "lan env ui",
      "description": "Open the terminal UI to manage runtimes visually"
    },
    {
      "command": "lan env config set shim.host runex",
      "description": "Make generated shims call `runex which` (per-package preference)"
    }
  ],
