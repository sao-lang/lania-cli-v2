{
  "name": "@lania-cli-v2/cmd-env",
  "version": "0.0.3",
  "description": "lan env — 可独立安装的 env 命令子包（零 TS payload）",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lan-env": "./bin/lan-env.mjs"
  },
  "files": [
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@lania-cli-v2/cmd-env-darwin-arm64": "workspace:*",
    "@lania-cli-v2/cmd-env-linux-x64": "workspace:*",
    "@lania-cli-v2/cmd-env-win32-x64": "workspace:*"
  },
  "configSchema": {
    "scope": "package",
    "path": "~/.lania/config/env.json",
    "keys": [
      {
        "key": "locale",
        "kind": "enum",
        "choices": [
          "zh",
          "en"
        ],
        "default": "en",
        "description": "包级偏好：界面语言（zh | en，默认 en）；与全局 lan config 的 locale 同名"
      },
      {
        "key": "output.mode",
        "kind": "enum",
        "choices": [
          "json",
          "human"
        ],
        "default": "json",
        "description": "包级偏好：输出模式（json | human，默认 json）；与全局 lan config 的 output.mode 同名"
      },
      {
        "key": "log.timestamps",
        "kind": "bool",
        "default": false,
        "description": "包级偏好：人类可读日志是否显示时间戳（默认 false）；与全局 lan config 的 log.timestamps 同名"
      },
      {
        "key": "shim.host",
        "kind": "enum",
        "choices": [
          "lan",
          "runex"
        ],
        "default": "lan",
        "description": "shims 调用的管理命令：lan（默认，`lan env which`）或 runex（`runex which`）；见拆分文档 §6.6"
      }
    ]
  }
}
