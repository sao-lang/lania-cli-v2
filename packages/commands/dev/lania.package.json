{
  "name": "dev",
  "kind": "command",
  "command": "dev",
  "versionFamily": "lan",
  "version": "0.0.3",
  "order": 1,
  "describe": "describes/dev.json",
  "api": {
    "protocol": 1,
    "rust": {
      "cratePath": "rust",
      "lib": "lania-plugins-command-dev",
      "bin": "lan-dev",
      "features": [],
      "dependencies": ["lania-cli-kit", "lania-bridge-host", "runex-home"],
      "api": {
        "factory": "lania-plugins-command-dev::factory",
        "spec": "lania-plugins-command-dev::spec",
        "surface": [
          "COMMAND_NAME",
          "HANDLER_ID",
          "DevCommandPlugin",
          "DevCommandPlugin::spec",
          "spec",
          "factory"
        ]
      }
    }
  },
  "rust": {
    "crates": ["rust"]
  },
  "npm": {
    "name": "@lania-cli-v2/cmd-dev",
    "bin": {
      "lan-dev": "npm/cmd-dev/bin/lan-dev.mjs"
    },
    "platformPackages": [
      "@lania-cli-v2/cmd-dev-darwin-arm64",
      "@lania-cli-v2/cmd-dev-linux-x64",
      "@lania-cli-v2/cmd-dev-win32-x64"
    ]
  },
  "payload": {
    "slices": ["compiler", "product", "config", "lifecycle", "lint", "toolchain"],
    "nodeBridge": true
  },
  "configSchema": {
    "scope": "package",
    "path": "~/.lania/config/dev.json",
    "keys": [
      {
        "key": "locale",
        "kind": "enum",
        "choices": ["zh", "en"],
        "default": "en",
        "description": "包级偏好：界面语言（zh | en，默认 en）；与全局 lan config 的 locale 同名"
      },
      {
        "key": "output.mode",
        "kind": "enum",
        "choices": ["json", "human"],
        "default": "json",
        "description": "包级偏好：输出模式（json | human，默认 json）；与全局 lan config 的 output.mode 同名"
      },
      {
        "key": "log.timestamps",
        "kind": "bool",
        "default": false,
        "description": "包级偏好：人类可读日志是否显示时间戳（默认 false）；与全局 lan config 的 log.timestamps 同名"
      }
    ]
  }
}
