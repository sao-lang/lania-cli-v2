{
  "name": "create",
  "kind": "command",
  "command": "create",
  "versionFamily": "lan",
  "version": "0.0.3",
  "order": 4,
  "describe": "describes/create.json",
  "api": {
    "protocol": 1,
    "rust": {
      "cratePath": "rust",
      "lib": "lania-plugins-command-create",
      "bin": "lan-create",
      "features": [],
      "dependencies": ["lania-cli-kit", "lania-bridge-host", "runex-home"],
      "api": {
        "factory": "lania-plugins-command-create::factory",
        "spec": "lania-plugins-command-create::spec",
        "surface": [
          "COMMAND_NAME",
          "HANDLER_ID",
          "CreateCommandPlugin",
          "CreateCommandPlugin::spec",
          "spec",
          "factory"
        ]
      }
    }
  },
  "rust": {
    "crates": ["rust"]
  },
  "npm": {
    "name": "@lania-cli-v2/cmd-create",
    "bin": {
      "lan-create": "npm/cmd-create/bin/lan-create.mjs"
    },
    "platformPackages": [
      "@lania-cli-v2/cmd-create-darwin-arm64",
      "@lania-cli-v2/cmd-create-linux-x64",
      "@lania-cli-v2/cmd-create-win32-x64"
    ]
  },
  "payload": {
    "slices": ["template", "dynamic-commands", "toolchain", "config"],
    "nodeBridge": true
  },
  "configSchema": {
    "scope": "package",
    "path": "~/.lania/config/create.json",
    "keys": [
      {
        "key": "locale",
        "kind": "enum",
        "choices": ["zh", "en"],
        "default": "en",
        "description": "包级偏好：界面语言（zh | en，默认 en）；与全局 lan config 的 locale 同名"
      },
      {
        "key": "output.mode",
        "kind": "enum",
        "choices": ["json", "human"],
        "default": "json",
        "description": "包级偏好：输出模式（json | human，默认 json）；与全局 lan config 的 output.mode 同名"
      },
      {
        "key": "log.timestamps",
        "kind": "bool",
        "default": false,
        "description": "包级偏好：人类可读日志是否显示时间戳（默认 false）；与全局 lan config 的 log.timestamps 同名"
      }
    ]
  },
  "description": "create 命令子包：从 10 个内置模板创建多运行时项目（含 template 二级命令）"
}
