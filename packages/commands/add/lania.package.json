{
  "name": "add",
  "kind": "command",
  "command": "add",
  "versionFamily": "lan",
  "version": "0.0.3",
  "order": 5,
  "describe": "describes/add.json",
  "api": {
    "protocol": 1,
    "rust": {
      "cratePath": "rust",
      "lib": "lania-plugins-command-add",
      "bin": "lan-add",
      "features": [],
      "dependencies": ["lania-cli-kit", "lania-bridge-host", "runex-home"],
      "api": {
        "factory": "lania-plugins-command-add::factory",
        "spec": "lania-plugins-command-add::spec",
        "surface": [
          "COMMAND_NAME",
          "HANDLER_ID",
          "AddCommandPlugin",
          "AddCommandPlugin::spec",
          "spec",
          "factory"
        ]
      }
    }
  },
  "rust": {
    "crates": ["rust"]
  },
  "npm": {
    "name": "@lania-cli-v2/cmd-add",
    "bin": {
      "lan-add": "npm/cmd-add/bin/lan-add.mjs"
    },
    "platformPackages": [
      "@lania-cli-v2/cmd-add-darwin-arm64",
      "@lania-cli-v2/cmd-add-linux-x64",
      "@lania-cli-v2/cmd-add-win32-x64"
    ]
  },
  "payload": {
    "slices": [],
    "nodeBridge": false
  },
  "configSchema": {
    "scope": "package",
    "path": "~/.lania/config/add.json",
    "keys": [
      {
        "key": "locale",
        "kind": "enum",
        "choices": ["zh", "en"],
        "default": "en",
        "description": "包级偏好：界面语言（zh | en，默认 en）；与全局 lan config 的 locale 同名"
      },
      {
        "key": "output.mode",
        "kind": "enum",
        "choices": ["json", "human"],
        "default": "json",
        "description": "包级偏好：输出模式（json | human，默认 json）；与全局 lan config 的 output.mode 同名"
      },
      {
        "key": "log.timestamps",
        "kind": "bool",
        "default": false,
        "description": "包级偏好：人类可读日志是否显示时间戳（默认 false）；与全局 lan config 的 log.timestamps 同名"
      }
    ]
  }
}
