{
  "name": "tools",
  "kind": "command",
  "command": "tools",
  "versionFamily": "lan",
  "version": "0.0.3",
  "order": 9,
  "describe": "describes/tools.json",
  "api": {
    "protocol": 1,
    "rust": {
      "cratePath": "rust",
      "lib": "lania-plugins-command-tools",
      "bin": "lan-tools",
      "features": [],
      "dependencies": ["lania-cli-kit", "lania-bridge-host", "runex-home"],
      "api": {
        "factory": "lania-plugins-command-tools::factory",
        "spec": "lania-plugins-command-tools::spec",
        "surface": [
          "COMMAND_NAME",
          "HANDLER_ID",
          "ToolsCommandPlugin",
          "ToolsCommandPlugin::spec",
          "spec",
          "factory"
        ]
      }
    }
  },
  "rust": {
    "crates": ["rust"]
  },
  "npm": {
    "name": "@lania-cli-v2/cmd-tools",
    "bin": {
      "lan-tools": "npm/cmd-tools/bin/lan-tools.mjs"
    },
    "platformPackages": [
      "@lania-cli-v2/cmd-tools-darwin-arm64",
      "@lania-cli-v2/cmd-tools-linux-x64",
      "@lania-cli-v2/cmd-tools-win32-x64"
    ]
  },
  "payload": {
    "slices": ["system", "dynamic-commands", "toolchain", "config"],
    "nodeBridge": true
  },
  "configSchema": {
    "scope": "package",
    "path": "~/.lania/config/tools.json",
    "keys": [
      {
        "key": "locale",
        "kind": "enum",
        "choices": ["zh", "en"],
        "default": "en",
        "description": "包级偏好：界面语言（zh | en，默认 en）；与全局 lan config 的 locale 同名"
      },
      {
        "key": "output.mode",
        "kind": "enum",
        "choices": ["json", "human"],
        "default": "json",
        "description": "包级偏好：输出模式（json | human，默认 json）；与全局 lan config 的 output.mode 同名"
      },
      {
        "key": "log.timestamps",
        "kind": "bool",
        "default": false,
        "description": "包级偏好：人类可读日志是否显示时间戳（默认 false）；与全局 lan config 的 log.timestamps 同名"
      }
    ]
  },
  "description": "tools 命令子包：命令发现、按类型运行文件与本地文件查看"
}
