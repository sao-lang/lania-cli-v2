{
  "name": "release",
  "kind": "command",
  "command": "release",
  "versionFamily": "lan",
  "version": "0.0.3",
  "order": 7,
  "describe": "describes/release.json",
  "api": {
    "protocol": 1,
    "rust": {
      "cratePath": "rust",
      "lib": "lania-plugins-command-release",
      "bin": "lan-release",
      "features": [],
      "dependencies": ["lania-cli-kit", "lania-bridge-host", "runex-home"],
      "api": {
        "factory": "lania-plugins-command-release::factory",
        "spec": "lania-plugins-command-release::spec",
        "surface": [
          "COMMAND_NAME",
          "HANDLER_ID",
          "ReleaseCommandPlugin",
          "ReleaseCommandPlugin::spec",
          "spec",
          "factory"
        ]
      }
    }
  },
  "rust": {
    "crates": ["rust"]
  },
  "npm": {
    "name": "@lania-cli-v2/cmd-release",
    "bin": {
      "lan-release": "npm/cmd-release/bin/lan-release.mjs"
    },
    "platformPackages": [
      "@lania-cli-v2/cmd-release-darwin-arm64",
      "@lania-cli-v2/cmd-release-linux-x64",
      "@lania-cli-v2/cmd-release-win32-x64"
    ]
  },
  "payload": {
    "slices": [],
    "nodeBridge": false
  },
  "configSchema": {
    "scope": "package",
    "path": "~/.lania/config/release.json",
    "keys": [
      {
        "key": "locale",
        "kind": "enum",
        "choices": ["zh", "en"],
        "default": "en",
        "description": "包级偏好：界面语言（zh | en，默认 en）；与全局 lan config 的 locale 同名"
      },
      {
        "key": "output.mode",
        "kind": "enum",
        "choices": ["json", "human"],
        "default": "json",
        "description": "包级偏好：输出模式（json | human，默认 json）；与全局 lan config 的 output.mode 同名"
      },
      {
        "key": "log.timestamps",
        "kind": "bool",
        "default": false,
        "description": "包级偏好：人类可读日志是否显示时间戳（默认 false）；与全局 lan config 的 log.timestamps 同名"
      }
    ]
  },
  "description": "release 命令子包：发布规划、执行、恢复与状态查询（零 TS payload）"
}
