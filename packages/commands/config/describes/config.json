{
  "name": "config",
  "about": "Manage global CLI preferences",
  "alias": null,
  "aliases": [],
  "args": [],
  "options": [],
  "examples": [
    {
      "command": "lan config",
      "description": "Show current global CLI configuration"
    },
    {
      "command": "lan config get locale",
      "description": "Read the current locale"
    },
    {
      "command": "lan config set locale zh",
      "description": "Switch CLI locale to Chinese"
    },
    {
      "command": "lan config set log.timestamps true",
      "description": "Enable timestamps for human-readable logs"
    },
    {
      "command": "lan config set output.mode json",
      "description": "Switch terminal output to JSON mode"
    },
    {
      "command": "lan config set output.mode human",
      "description": "Switch terminal output to human mode"
    },
    {
      "command": "lan config init",
      "description": "Create a lan.config.ts for the current project"
    },
    {
      "command": "lan config doctor",
      "description": "Diagnose the project lan.config (read-only)"
    },
    {
      "command": "lan config set runtime go",
      "description": "Pin the project runtime in lan.config.ts"
    },
    {
      "command": "lan config sync",
      "description": "Suggest project config entries that are missing"
    }
  ],
  "subcommands": [
