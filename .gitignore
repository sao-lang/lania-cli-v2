# OS / editor
.DS_Store
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.*
!.env.example

# Dependencies
node_modules/
ts/node_modules/
ts/packages/*/node_modules/
npm/cli/node_modules/
npm/cli-darwin-arm64/node_modules/

# Build outputs
dist/
coverage/
*.tsbuildinfo

# Rust
target/

# Staged npm payloads / release artifacts
npm/cli/lib/node-bridge/
npm/cli/*.tgz
# 平台二进制包的 bin/ 在发布时填充，仓库态只有 .gitkeep。
# 阶段 6a-1 后 npm/ 迁入 packages/，旧规则（npm/cli-*/bin/...）对新目录失效；
# 改用新布局通配，避免本机编译产物（数百 MB 的 debug exe）被意外提交。
packages/commands/*/npm/cmd-*-darwin-arm64/bin/*
packages/commands/*/npm/cmd-*-linux-x64/bin/*
packages/commands/*/npm/cmd-*-win32-x64/bin/*
packages/distribution/cli/npm/cli-darwin-arm64/bin/*
packages/distribution/cli/npm/cli-linux-x64/bin/*
packages/distribution/cli/npm/cli-win32-x64/bin/*
packages/distribution/cli/npm/cli-*/*.tgz
.lania/platform-binaries/

# Package manager / tooling caches
.pnpm-store/
.turbo/
.cache/

# Temporary files
tmp/
temp/
/.tmp*
__pycache__/
*.pyc

.lania

# 注意：不要写裸 `lania-cli`，它会连带忽略 rust/crates/lania-cli/ 下的新文件。
/lania-cli

# Superpowers scratch
.superpowers/
.VSCodeCounter
.runex-demo

# 本地 agent 工作区（会话记忆等），不入库
.workbuddy/

# bridge-protocol 的协议生成物（构建时由 scripts/copy-gen.mjs 同步）
packages/products/bridge-hub/protocol/npm/bridge-protocol/src/
